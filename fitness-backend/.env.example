# Fitness Backend API – copy to .env and fill in values
# Optional: MongoDB connection string (e.g. from MongoDB Atlas)
# If omitted, the server runs in DEV mode with in-memory storage (data is lost on restart).
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/fitness_app?retryWrites=true&w=majority

# Optional: port (default 3000)
PORT=3000
